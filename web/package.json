{
  "name": "graphman-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GraphMan observatory: a visual front-end for the GraphMan graph library",
  "scripts": {
    "dev": "npm run data && vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "data": "node scripts/sync-data.mjs"
  },
  "dependencies": {
    "border-beam": "^1.3.0",
    "liquid-gooey": "^0.2.1",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
